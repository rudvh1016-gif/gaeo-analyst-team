# 계속 갱신되는 로그(의미있는 이력 아님)
update.log
# macOS
.DS_Store
# Python 컴파일 캐시
__pycache__/
# Research Shadow 중간 산출물 — analyze_auto.py가 쓰고 archive_analysis.py가 바로 읽는
# 한 사이클짜리 전달 파일(6MB). 영구 기록은 research_history.jsonl에 남으므로 커밋하지 않는다.
research_shadow.json

# 브라우저 테스트 스크린샷(로컬 산출물)
.test-screenshots/

# 로컬 민감파일 — Secret은 GitHub Actions Secrets/환경변수로만 쓴다(2026-08-16 보안 정리).
# 아래 패턴과 겹치는 정상 파일이 저장소에 없음을 확인하고 추가했다.
.env
.env.*
*.key
*.pem
credentials*
secrets.*

# 공유 Toss 토큰 산출물 — 기본 저장 위치는 저장소 **바깥**(%LOCALAPPDATA%\GAEO\secrets 등)이다.
# 다만 GAEO_SECRETS_DIR 를 저장소 안으로 잘못 지정했을 때를 대비한 안전망이다.
# 정상 binary asset까지 무시하지 않도록 실제 파일명 기준으로만 막는다(*.bin 같은 광범위 패턴 금지).
toss_shared_access_token*
toss_token.lock
*.dpapi

# GS Reference Lab 산출물 — 검산 결과는 '있으면 좋은' 참고자료다.
# Production 판단에 안 쓰이고 gs_quant 설치 여부에 따라 내용이 달라지므로
# 저장소에 커밋하지 않는다(evolution-lab은 RUNNER_TEMP에 쓰고 그 자리에서 읽는다).
gaeo_reference/state/
